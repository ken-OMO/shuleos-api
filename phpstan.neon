includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    level: 5

    squashedMigrationsPath:
        - tools/phpstan/schema

    excludePaths:
        analyse:
            - app/Services/Teaching/LessonNoteService.php
            - app/Services/Teaching/RecordOfWorkService.php
            - app/Http/Controllers/Api/LessonNoteController.php
            - app/Http/Controllers/Api/LessonPlanController.php
            - app/Http/Controllers/Api/RecordOfWorkController.php
            - app/Http/Controllers/Api/SchemeLessonController.php

    ignoreErrors: []
