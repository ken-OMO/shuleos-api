APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

PARENT_PAYMENT_PROVIDER=log
PARENT_PAYMENT_MINIMUM_MINOR=100
PARENT_PAYMENT_MAXIMUM_MINOR=100000000
PARENT_PAYMENT_ATTEMPT_EXPIRY_MINUTES=30
PARENT_PUSH_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_TIMEOUT=10
MPESA_RETRY_LIMIT=1

SHULEOS_FRONTEND_URL=https://shuleos.co.ke
COMMUNICATION_EMAIL_PROVIDER=log
COMMUNICATION_FROM_ADDRESS=noreply@shuleos.co.ke
COMMUNICATION_FROM_NAME=ShuleOS
COMMUNICATION_EMAIL_TIMEOUT=10
COMMUNICATION_EMAIL_RETRY_LIMIT=3
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_WEBHOOK_SECRET=
COMMUNICATION_SMS_PROVIDER=fake
COMMUNICATION_SMS_ENABLED=false
COMMUNICATION_SMS_MAXIMUM_SEGMENTS=4
COMMUNICATION_SANDBOX_SMOKE_ENABLED=false
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com
AFRICASTALKING_WEBHOOK_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
